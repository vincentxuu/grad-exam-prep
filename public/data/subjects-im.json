    "materials": [
      {
        "title": "于天立《計算機概論》（台大開放式課程，21 講）",
        "author": "于天立",
        "type": "video",
        "url": "https://ocw.aca.ntu.edu.tw/courses/101S210",
        "note": "無補習路線的主幹課程，講義可下載。多篇上榜心得的第一門課"
      },
      {
        "title": "Brookshear《Computer Science: An Overview》13/e",
        "author": "J. Glenn Brookshear",
        "type": "book",
        "url": "https://www.tenlong.com.tw/products/9781292263427",
        "note": "自學者的主力用書，有中譯本。心得共識：影音課講得淺，觀念要靠這本補"
      },
      {
        "title": "孔令傑《程式設計（C++）— 完整課程》（15 講）",
        "author": "孔令傑",
        "type": "video",
        "url": "https://www.youtube.com/playlist?list=PLMHSr8fseBzUvwjKtR6pX0Vv9Q9H-V3lY",
        "note": "台大資管大一必修課本身。台大計概固定考兩題 C++ 手寫題"
      },
      {
        "title": "周志遠《作業系統》（清大開放式課程，78 部）",
        "author": "周志遠",
        "type": "video",
        "url": "https://www.youtube.com/playlist?list=PLS0SUwlYe8cxj8FCPRoPHAehIiN9Vo6VZ",
        "note": "無補習考資管／資工所的共同推薦。覺得太難可改看杰哥數位教室的作業系統"
      },
      {
        "title": "黃能富《計算機網路》（清大開放式課程）",
        "author": "黃能富",
        "type": "video",
        "url": "https://www.youtube.com/playlist?list=PLS0SUwlYe8cxktXNovos9xleroaWyb-z5",
        "note": "多位心得只看到無線區域網路／Ethernet 結束。台大網路題廣而不深，PowerCert 也夠用"
      },
      {
        "title": "杰哥數位教室 資料結構／演算法／資料庫課程",
        "author": "陳士杰",
        "type": "video",
        "url": "https://www.youtube.com/playlist?list=PLpbuzGqDFzkhHPz11AeGrU7K8AKNqp0fj",
        "note": "免費且附投影片，音質較差。資料庫讀到正規化與 SQL 即可，交易管理很少考"
      },
      {
        "title": "蔡明志《資料結構：使用C++》第五版",
        "author": "蔡明志",
        "type": "book",
        "url": "https://www.books.com.tw/products/0010903831",
        "note": "配影音課用。手寫題出在資結，程式碼要練到能默寫"
      },
      {
        "title": "李宏毅《機器學習》與生成式 AI 課程",
        "author": "李宏毅",
        "type": "video",
        "url": "https://www.youtube.com/playlist?list=PLJV_el3uVTsOePyfmkfivYZ7Rqr2nMk3W",
        "note": "AI 是逐年加重的趨勢題。深度學習基礎可用 iThome 鐵人賽系列文補"
      },
      {
        "title": "蝦皮資管所計概筆記（藍底白字那套）",
        "type": "notes",
        "note": "開讀前掃一遍建立地圖、後期當索引。心得明講資結與網路部分太簡略，不能當唯一教材"
      },
      {
        "title": "補習班計概講義（大碩/TKB）",
        "type": "cram-school",
        "note": "非必需。心得評語：參考書要搭配上課才有效益，自學不如直接讀原文書"
      }
    ]
