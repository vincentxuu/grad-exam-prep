# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Cloudflare 本機 secret（wrangler / OpenNext dev 會讀這支）
# 範本 .dev.vars.example 可以進版控，實際的 key 不行
.dev.vars
.dev.vars.*
!.dev.vars.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cloudflare build output
/.open-next/
/.wrangler/

# omc
/.omc/

# generated question files (regenerable from questions.json)
/public/data/qfiles/

# Claude Code 本機權限設定（含 session 專屬的 MCP server id，不進版控）
.claude/settings.local.json
